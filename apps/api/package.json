{
  "name": "@endemion/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API Endemion Life: сервер — источник истины для игрового состояния",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@endemion/database": "workspace:*",
    "@endemion/game-core": "workspace:*",
    "@endemion/shared": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@sentry/node": "11.10.0",
    "body-parser": "2.4.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.3.2",
    "@types/body-parser": "1.19.6",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "oidc-provider": "9.13.3",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vitest": "catalog:"
  }
