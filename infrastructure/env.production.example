# Рабочая среда Endemion Life. Скопируйте в .env в корне проекта НА СЕРВЕРЕ и замените значения:
#   cp infrastructure/env.production.example .env && chmod 600 .env
# Этот файл — образец: в нём нет настоящих паролей. Файл .env в Git не попадает

# ---------- Домен и HTTPS ----------
DOMAIN=life.endemion.online
# Адрес для писем Let's Encrypt (окончание срока сертификата)
LETSENCRYPT_EMAIL=admin@endemion.online
# tls — свой сертификат (порты 80, 443); behind-proxy — HTTPS обслуживает внешний прокси (docs/HTTPS_SETUP.md)
NGINX_MODE=tls
# HSTS: 0 — выключен. После проверки HTTPS (check-https.sh) поставьте 63072000 и перезапустите nginx
HSTS_MAX_AGE=0
# Для behind-proxy: сеть Docker внешнего прокси и её подсеть (docker network inspect <сеть>)
# PROXY_NETWORK=endemion_default
# REAL_IP_FROM=172.18.0.0/16

# ---------- База данных ----------
POSTGRES_USER=endemion
# Только [A-Za-z0-9_-], не короче 32 символов. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=endemion_life

# ---------- Почта (подтверждение адреса и восстановление доступа) ----------
# Без SMTP_URL письма не отправляются: регистрация работает, но подтвердить почту и восстановить пароль нельзя
# Пример: smtps://login:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Endemion Life <no-reply@endemion.online>

# ---------- Endemion ID (единый аккаунт с endemion.online) ----------
# true — вход только через auth.endemion.online, старые вход и регистрация по почте закрыты.
# Откат: false и перезапуск api. Подробно — docs/ENDEMION_ID.md
ENDEMION_ID=false
ENDEMION_ID_ISSUER=https://auth.endemion.online
ENDEMION_ID_CLIENT_ID=endemion-life-web
# Тот же секрет, что у клиента endemion-life-web в OIDC_CLIENTS сервиса Endemion ID: openssl rand -hex 32
ENDEMION_ID_CLIENT_SECRET=
# Ключ шифрования refresh token в базе Life: openssl rand -base64 32. Смена ключа завершит входы через Endemion ID
ENDEMION_ID_TOKEN_KEY=

# ---------- Ограничения ----------
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---------- Наблюдение ----------
LOG_LEVEL=info
# Sentry или совместимый сервис (GlitchTip). Пусто — ошибки только в журнале
SENTRY_DSN=
# Оповещения: webhook Slack, Discord или Telegram Bot API (docs/MONITORING.md)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=slack
ALERT_TELEGRAM_CHAT_ID=
# Внешняя проверка сайта целиком (через DNS, HTTPS и Nginx)
MONITOR_PUBLIC_URL=https://life.endemion.online/api/health
# «Пульс» для внешнего монитора (healthchecks.io и аналоги): заметит, если упал весь сервер
HEALTHCHECKS_PING_URL=
HEALTHCHECKS_BACKUP_PING_URL=

# ---------- Резервные копии ----------
# Каталог на диске сервера (относительно infrastructure/ или абсолютный путь)
BACKUP_HOST_DIR=/var/backups/endemion-life
# Время по cron: минута час день месяц день_недели. 30 3 * * * — каждый день в 03:30 по BACKUP_TZ
BACKUP_SCHEDULE=30 3 * * *
BACKUP_TZ=Europe/Moscow
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=7
BACKUP_VERIFY_FULL=true
# Внешнее S3-совместимое хранилище (необязательно). Пример: backup:endemion-life-backups
BACKUP_S3_REMOTE=
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Other
RCLONE_CONFIG_BACKUP_ENDPOINT=
RCLONE_CONFIG_BACKUP_REGION=
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
