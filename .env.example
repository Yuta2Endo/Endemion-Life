# Скопируйте в .env в корне проекта: cp .env.example .env
# API и Prisma читают этот файл. Значения ниже подходят для локальной разработки с infrastructure/docker-compose.yml

# ---------- База данных ----------
POSTGRES_USER=endemion
POSTGRES_PASSWORD=endemion_dev_password
POSTGRES_DB=endemion_life
DATABASE_URL=postgresql://endemion:endemion_dev_password@127.0.0.1:5432/endemion_life
# База для тестов API (pnpm test:api создаёт схему сам)
DATABASE_URL_TEST=postgresql://endemion:endemion_dev_password@127.0.0.1:5432/endemion_life_test

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- API ----------
API_PORT=4000
# Адреса, с которых браузер может обращаться к API напрямую (через запятую). В разработке сайт ходит через прокси Next.js
CORS_ORIGINS=http://localhost:3000
# Лимит запросов с одного адреса в минуту (Redis). 0 — без лимита
RATE_LIMIT_PER_MINUTE=120
# Лимит попыток входа, регистрации и восстановления пароля в минуту — на адрес и на почту.
# Действует и без Redis (счётчик в памяти процесса). 0 — без лимита
AUTH_RATE_LIMIT_PER_MINUTE=10
# Cookie сессии только по HTTPS. По умолчанию true при NODE_ENV=production.
# Локально по HTTP оставьте false (по умолчанию вне production)
# COOKIE_SECURE=false
# Адрес сайта для ссылок в письмах. По умолчанию — первый адрес из CORS_ORIGINS
# PUBLIC_URL=http://localhost:3000
# Каким прокси верить в X-Forwarded-For. loopback — прокси на этом же компьютере.
# В docker-compose.prod.yml задано loopback, uniquelocal (Nginx в соседнем контейнере)
# TRUST_PROXY=loopback
# Stage 15: токен управления живыми окнами. Пусто — маршрутов управления нет (ответ 404).
# Не задавайте в рабочей среде, пока окна не ведут вручную. Минимум 16 символов.
# LIVE_OPS_TOKEN=

# ---------- Почта (подтверждение адреса, восстановление пароля) ----------
# smtp — отправка через SMTP_URL; file — письма в JSON в .mail-outbox/ (только разработка);
# memory — в памяти (тесты); none — не отправлять. По умолчанию: smtp при SMTP_URL, иначе file (вне production) или none
# MAIL_DRIVER=file
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Endemion Life <no-reply@example.com>"
# MAIL_OUTBOX_DIR=.mail-outbox

# ---------- Журналы и ошибки ----------
# LOG_LEVEL=info          # error | warn | info | debug
# LOG_FORMAT=pretty       # json (по умолчанию в production) | pretty
# SENTRY_DSN=             # пусто — Sentry выключен

# ---------- Миграции ----------
# Пустая база для проверки расхождений схемы и миграций (prisma migrate diff)
# SHADOW_DATABASE_URL=postgresql://endemion:endemion_dev_password@127.0.0.1:5432/endemion_life_shadow

# ---------- Рабочая среда ----------
# Настройки сервера — в infrastructure/env.production.example (отдельный файл, не этот)

# ---------- Endemion ID (вход через auth.endemion.online) ----------
# true — вход через Endemion ID. Для разработки запустите провайдер из репозитория Endemion (auth/, npm run dev)
# и добавьте клиента endemion-life-web с redirect_uri http://localhost:3000/api/auth/oidc/callback
# ENDEMION_ID=false
# ENDEMION_ID_ISSUER=http://localhost:3001
# ENDEMION_ID_CLIENT_ID=endemion-life-web
# ENDEMION_ID_CLIENT_SECRET=
# ENDEMION_ID_TOKEN_KEY=            # openssl rand -base64 32

# ---------- Stage 11.2: портал Endemion → Life ----------
# false — маршрутов /api/portal/* нет, они отвечают 404. Включать только после
# согласованной настройки портала, JWKS и ключей (см. STAGE_11_2_DEPLOYMENT_PREREQUISITES.md).
# PORTAL_INTEGRATION_ENABLED=false
# Точные значения контракта. Менять только вместе с порталом
# PORTAL_JWT_ISSUER=https://endemion.online
# PORTAL_JWT_AUDIENCE=https://life.endemion.online
# PORTAL_JWKS_URL=https://endemion.online/.well-known/jwks.json
# PORTAL_JWKS_CACHE_TTL_SECONDS=300
# PORTAL_JWKS_TIMEOUT_MS=3000
# PORTAL_JWKS_MIN_REFRESH_MS=10000
# Аварийная блокировка скомпрометированных kid через запятую
# PORTAL_JWKS_BLOCKED_KIDS=
# Лимит запросов в минуту на один Endemion ID (sub). 0 — без лимита
# PORTAL_SUBJECT_RATE_LIMIT_PER_MINUTE=60

# ---------- Сайт ----------
# Куда Next.js проксирует /api/* (сервер Next.js, не браузер)
API_INTERNAL_URL=http://127.0.0.1:4000
