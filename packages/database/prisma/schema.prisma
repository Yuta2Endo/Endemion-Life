// Схема базы Endemion Life. Адрес базы задаётся в prisma.config.ts (DATABASE_URL из .env)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Владелец игровых жизней. Гость — игрок без аккаунта; после регистрации у игрока появляется Account.
/// Все проверки доступа к жизням идут по player_id сессии
model Player {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Endemion ID (claim sub). Прогресс привязан к игроку, игрок — к sub: смена username или почты его не меняет
  endemionSub   String? @unique @map("endemion_sub") @db.Uuid
  /// Профиль из Endemion ID для показа в игре, обновляется при сверке сессии.
  /// Поиск без учёта регистра идёт по индексам ниже: PostgreSQL берёт их для lower(column) = lower($1)
  idUsername    String? @map("id_username") @db.VarChar(24)
  idDisplayName String? @map("id_display_name") @db.VarChar(40)
  idAvatarUrl   String? @map("id_avatar_url") @db.VarChar(512)
  idEmail       String? @map("id_email") @db.VarChar(254)

  lives    Life[]
  actions  GameAction[]
  sessions Session[]
  account  Account?
  /// Stage 07: связи, где игрок стоит первым в паре (меньший id)
  tiesAsA  Tie[]    @relation("TieA")
  /// Связи, где игрок стоит вторым
  tiesAsB  Tie[]    @relation("TieB")
  /// Stage 15: вклады игрока в живые окна
  liveParts LivePart[]
  /// Stage 05: вклад в общий мир
  worldContributions WorldContribution[]
  reportsMade       PlayerReport[]       @relation("ReportReporter")
  reportsReceived   PlayerReport[]       @relation("ReportTarget")

  @@index([idDisplayName])
  @@index([idUsername])
  @@map("players")
}

/// Stage 07: связь двух игроков. player_a всегда меньше player_b, поэтому пара одна.
/// pending — ждёт ответа, accepted — друзья, blocked — автор блока в asked_by
model Tie {
  id        String   @id @default(uuid()) @db.Uuid
  playerAId String   @map("player_a") @db.Uuid
  playerBId String   @map("player_b") @db.Uuid
  status    String   @db.VarChar(16)
  /// Кто отправил запрос или поставил блок
  askedById String   @map("asked_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  playerA Player @relation("TieA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB Player @relation("TieB", fields: [playerBId], references: [id], onDelete: Cascade)

  @@unique([playerAId, playerBId])
  @@index([playerAId])
  @@index([playerBId])
  @@map("ties")
}

/// Сессия (устройство). В cookie лежит случайный токен, здесь — только его SHA-256.
/// Отозванная или просроченная сессия не даёт доступа
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  playerId   String    @map("player_id") @db.Uuid
  userAgent  String?   @map("user_agent") @db.VarChar(256)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Вход через Endemion ID: зашифрованный refresh token (AES-GCM) и время сверок с провайдером
  refreshToken String?   @map("refresh_token") @db.Text
  refreshedAt  DateTime? @map("refreshed_at") @db.Timestamptz(3)
  lastOkAt     DateTime? @map("last_ok_at") @db.Timestamptz(3)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("sessions")
}

/// Начатый вход через Endemion ID. Ключ — SHA-256 от state из cookie, запись удаляется при ответе провайдера
model OidcLogin {
  stateHash    String   @id @map("state_hash") @db.Char(64)
  codeVerifier String   @map("code_verifier") @db.VarChar(128)
  nonce        String   @db.VarChar(128)
  returnTo     String   @map("return_to") @db.VarChar(512)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("oidc_logins")
}

/// Аккаунт по email. Один аккаунт — один игрок: жизни аккаунта принадлежат его игроку
model Account {
  id              String    @id @default(uuid()) @db.Uuid
  playerId        String    @unique @map("player_id") @db.Uuid
  /// Нормализованный адрес: без пробелов, в нижнем регистре
  email           String    @unique @db.VarChar(254)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// scrypt: параметры, соль и хеш в одной строке. Пароль в открытом виде не хранится нигде
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  /// Неудачные попытки входа подряд. После порога вход блокируется до locked_until
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokens AuthToken[]

  @@map("accounts")
}

enum AuthTokenPurpose {
  verify_email
  reset_password
}

/// Одноразовые коды подтверждения почты и ссылки восстановления доступа. Хранится только хеш
/// (для кода — SHA-256 от "id аккаунта:код", поэтому одинаковые коды разных аккаунтов не совпадают).
/// used_at заполняется один раз: повторное использование невозможно
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  accountId String           @map("account_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @map("token_hash") @db.Char(64)
  /// Сколько раз вводили код. После порога код аннулируется
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, createdAt])
  @@index([tokenHash])
  @@map("auth_tokens")
}

enum LifeStatus {
  alive
  dead
}

/// Жизнь персонажа. state — полное состояние игры (GameState из game-core), version растёт с каждым действием
model Life {
  id         String     @id @default(uuid()) @db.Uuid
  playerId   String     @map("player_id") @db.Uuid
  universeId String     @map("universe_id") @db.VarChar(32)
  name       String     @db.VarChar(64)
  seed       String     @db.VarChar(64)
  status     LifeStatus @default(alive)
  version    Int
  age        Int
  /// Версия формата сохранения в state (SAVE_SCHEMA_VERSION). Жизни Stage 01 (1) переводятся в новый формат при следующем действии
  schemaVersion Int      @default(1) @map("schema_version")
  /// Stage 03: род. Все поколения одного рода имеют один lineage_id (id жизни основателя). NULL — жизнь до Stage 03, род — она сама
  lineageId     String?  @map("lineage_id") @db.Uuid
  /// Поколение рода: 1 — основатель
  generation    Int      @default(1)
  /// Жизнь, после которой эта продолжила род. Уникально: у одной жизни не бывает двух наследников
  predecessorId String?  @unique @map("predecessor_id") @db.Uuid
  /// Stage 04: откуда жизнь. server — создана и прожита на сервере; local-import — перенесена из браузера (прошлые исходы не проверены)
  origin        String   @default("server") @db.VarChar(16)
  /// Stage 04: ключ переноса от клиента. Повтор с тем же ключом возвращает ту же жизнь
  importId      String?  @map("import_id") @db.Uuid
  state      Json
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  player    Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  snapshots LifeSnapshot[]
  history   HistoryEntry[]
  actions   GameAction[]

  predecessor Life?  @relation("Succession", fields: [predecessorId], references: [id], onDelete: SetNull)
  successor   Life?  @relation("Succession")

  @@index([playerId, updatedAt(sort: Desc)])
  @@index([schemaVersion])
  @@index([lineageId, generation])
  @@unique([playerId, importId])
  @@map("lives")
}

enum SnapshotReason {
  create
  action
  restore
}

/// Версии сохранения: к любой из них жизнь можно откатить
model LifeSnapshot {
  id        String         @id @default(uuid()) @db.Uuid
  lifeId    String         @map("life_id") @db.Uuid
  version   Int
  age       Int
  reason    SnapshotReason
  state     Json
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  life Life @relation(fields: [lifeId], references: [id], onDelete: Cascade)

  @@unique([lifeId, version])
  @@map("life_snapshots")
}

/// Запись хронологии жизни. Номер seq уникален в пределах жизни: одно событие не запишется дважды
model HistoryEntry {
  id        String   @id @default(uuid()) @db.Uuid
  lifeId    String   @map("life_id") @db.Uuid
  seq       Int
  age       Int
  kind      String   @db.VarChar(16)
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  life Life @relation(fields: [lifeId], references: [id], onDelete: Cascade)

  @@unique([lifeId, seq])
  @@map("history_entries")
}

/// Принятые действия. (lifeId, actionId) уникальны: повторная отправка возвращает сохранённый ответ
model GameAction {
  id          String   @id @default(uuid()) @db.Uuid
  lifeId      String   @map("life_id") @db.Uuid
  playerId    String   @map("player_id") @db.Uuid
  actionId    String   @map("action_id") @db.Uuid
  type        String   @db.VarChar(16)
  payload     Json
  fromVersion Int      @map("from_version")
  toVersion   Int      @map("to_version")
  /// Записи истории, добавленные действием: для ответа на повтор
  entries     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  life   Life   @relation(fields: [lifeId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([lifeId, actionId])
  @@index([playerId, createdAt])
  @@map("game_actions")
}

/// Stage 15: живое окно. Срок в UTC. Состояние меняется только проверенным переходом.
/// draft — черновик, scheduled — ждёт срока, active — идёт, completed — срок вышел,
/// cancelled — снято, archived — убрано из доски
model LiveWindow {
  id         String    @id @default(uuid()) @db.Uuid
  /// Шаблон из кода. Пустое — окно задано вручную
  templateId String?   @map("template_id") @db.VarChar(40)
  /// Ключ слота шаблона: повтор того же дня или недели находит эту строку
  slotKey    String?   @unique @map("slot_key") @db.VarChar(80)
  titleRu    String    @map("title_ru") @db.VarChar(80)
  titleEn    String    @map("title_en") @db.VarChar(80)
  textRu     String    @map("text_ru") @db.VarChar(400)
  textEn     String    @map("text_en") @db.VarChar(400)
  status     String    @db.VarChar(16)
  /// Пусто — все шесть миров. Иначе id через запятую
  worlds     String    @default("") @db.VarChar(80)
  minAge     Int       @default(10) @map("min_age")
  goal       Int
  /// Сколько раз одна жизнь может вложиться
  perLife    Int       @default(1) @map("per_life")
  /// Золото награды. Новой валюты нет
  gold       Int       @default(0)
  /// Флаг в жизни после выдачи: live.<id окна>
  flag       String    @db.VarChar(40)
  progress   Int       @default(0)
  startsAt   DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime  @map("ends_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  parts LivePart[]
  log   LiveLog[]

  @@index([status, endsAt])
  @@map("live_windows")
}

/// Вклад одной жизни в одно окно. Повтор в тот же год жизни не считается
model LivePart {
  id         String   @id @default(uuid()) @db.Uuid
  windowId   String   @map("window_id") @db.Uuid
  playerId   String   @map("player_id") @db.Uuid
  lifeId     String   @map("life_id") @db.Uuid
  count      Int      @default(0)
  /// Год жизни, в котором уже вложились. Пусто — ещё не вкладывались
  lastAge    Int?     @map("last_age")
  /// Когда награда записана. Повтор не выдаёт золото второй раз
  claimedAt  DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  window LiveWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  player Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([windowId, lifeId])
  @@index([playerId])
  @@map("live_parts")
}

/// Кто перевёл окно и куда. Удаления нет
model LiveLog {
  id        String   @id @default(uuid()) @db.Uuid
  windowId  String   @map("window_id") @db.Uuid
  actor     String   @db.VarChar(16)
  from      String   @db.VarChar(16)
  to        String   @db.VarChar(16)
  note      String   @default("") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  window LiveWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)

  @@index([windowId, createdAt])
  @@map("live_log")
}

/// Stage 04 — Living Worlds: общий мир сервера. Одна строка на вселенную, состояние — полный
/// SharedWorldState из game-core. Это отдельная проекция: жизни на неё не пишут и от неё не зависят
model World {
  id                 String    @id @default(uuid()) @db.Uuid
  universeId         String    @unique @map("universe_id") @db.VarChar(32)
  /// Детерминированный seed из id вселенной
  seed               String    @db.VarChar(64)
  version            Int       @default(1)
  season             Int
  /// Контрольная сумма текущего состояния (не криптографическая подпись)
  checksum           String    @db.VarChar(32)
  state              Json
  lastTickDurationMs Int       @default(0) @map("last_tick_duration_ms")
  lastTickAt         DateTime? @map("last_tick_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  seasons     WorldSeason[]
  settlements Settlement[]
  factions    Faction[]
  events      WorldEvent[]
  commands    WorldCommand[]
  audits      WorldAudit[]
  contributions WorldContribution[]

  @@map("worlds")
}

/// Снимок сезона: состояние, контрольная сумма и длительность хода.
/// (world_id, season) уникальны: повторный tick не создаёт вторую запись
model WorldSeason {
  id         String   @id @default(uuid()) @db.Uuid
  worldId    String   @map("world_id") @db.Uuid
  season     Int
  checksum   String   @db.VarChar(32)
  state      Json
  /// Длительность tick в миллисекундах. Для снимка, изменённого командой, не пересчитывается
  durationMs Int      @default(0) @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, season])
  @@index([worldId, season])
  @@map("world_seasons")
}

/// Нормализованная проекция поселения для чтения и отчётов. Источник истины — worlds.state
model Settlement {
  id                String   @id @default(uuid()) @db.Uuid
  worldId           String   @map("world_id") @db.Uuid
  settlementId      String   @map("settlement_id") @db.VarChar(48)
  nameRu            String   @map("name_ru") @db.VarChar(120)
  nameEn            String   @map("name_en") @db.VarChar(120)
  kind              String   @db.VarChar(16)
  tags              String[] @default([])
  wageFactor        Float    @map("wage_factor")
  costFactor        Float    @map("cost_factor")
  travelCost        Int      @map("travel_cost")
  population        Int
  prosperity        Int
  stability         Int
  dominantFactionId String?  @map("dominant_faction_id") @db.VarChar(48)
  /// Товары поселения (id, base, supply, buy, sell, тексты)
  goods             Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, settlementId])
  @@index([worldId])
  @@map("settlements")
}

/// Нормализованная проекция фракции. Источник истины — worlds.state
model Faction {
  id         String   @id @default(uuid()) @db.Uuid
  worldId    String   @map("world_id") @db.Uuid
  factionId  String   @map("faction_id") @db.VarChar(48)
  nameRu     String   @map("name_ru") @db.VarChar(120)
  nameEn     String   @map("name_en") @db.VarChar(120)
  power      Int
  influence  Int
  standing   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, factionId])
  @@index([worldId])
  @@map("factions")
}

/// Событие мира. Журнал в состоянии ограничен 40 записями, здесь копятся все сезоны.
/// id события детерминирован (tick:… или admin:…) и уникален в пределах вселенной
model WorldEvent {
  id           String   @id @db.VarChar(96)
  worldId      String   @map("world_id") @db.Uuid
  season       Int
  kind         String   @db.VarChar(16)
  titleRu      String   @map("title_ru") @db.VarChar(160)
  titleEn      String   @map("title_en") @db.VarChar(160)
  textRu       String   @map("text_ru") @db.VarChar(600)
  textEn       String   @map("text_en") @db.VarChar(600)
  settlementId String?  @map("settlement_id") @db.VarChar(48)
  factionId    String?  @map("faction_id") @db.VarChar(48)
  severity     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId, season])
  @@index([worldId, createdAt])
  @@map("world_events")
}

/// Журнал команд: tick и правки администратора. Replay идёт от seed по seq.
/// payload — SharedWorldCommand целиком, чтобы воспроизведение не зависело от проекций
model WorldCommand {
  id           String   @id @default(uuid()) @db.Uuid
  worldId      String   @map("world_id") @db.Uuid
  seq          Int
  type         String   @db.VarChar(16)
  payload      Json
  seasonBefore Int      @map("season_before")
  seasonAfter  Int      @map("season_after")
  checksum     String   @db.VarChar(32)
  actor        String   @default("ops") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, seq])
  @@index([worldId, createdAt])
  @@map("world_commands")
}

/// Аудит действий администратора. Токен и его части сюда не пишутся
model WorldAudit {
  id        String   @id @default(uuid()) @db.Uuid
  worldId   String   @map("world_id") @db.Uuid
  action    String   @db.VarChar(48)
  actor     String   @default("ops") @db.VarChar(64)
  detail    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId, createdAt])
  @@map("world_audits")
}

/// Stage 05: уникальный вклад аккаунта в общий мир.
/// action_id даёт идемпотентность retry, (world, player, season) - один вклад за сезон.
model WorldContribution {
  id         String   @id @default(uuid()) @db.Uuid
  worldId    String   @map("world_id") @db.Uuid
  playerId   String   @map("player_id") @db.Uuid
  actionId   String   @map("action_id") @db.Uuid
  season     Int
  targetKind String   @map("target_kind") @db.VarChar(16)
  targetId   String   @map("target_id") @db.VarChar(48)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  world  World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, actionId])
  @@unique([worldId, playerId, season])
  @@index([worldId, season])
  @@map("world_contributions")
}

/// Stage 05: жалобы игроков. Обрабатываются вне игры, без автоматических санкций.
model PlayerReport {
  id         String   @id @default(uuid()) @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  targetId   String   @map("target_id") @db.Uuid
  reason     String   @db.VarChar(32)
  details    String?  @db.VarChar(500)
  status     String   @default("open") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter Player @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target   Player @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, createdAt])
  @@index([status, createdAt])
  @@map("player_reports")
}

/// Stage 16: факт хода. Не состояние игры. Игрок, почта и текст сюда не пишутся.
/// ref уникален вместе с name: повтор того же хода не двоит счётчик
model Insight {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(24)
  /// Мир, если факт к нему относится. Пусто — общий
  world     String   @default("") @db.VarChar(32)
  /// Возраст персонажа в момент факта. 0 — не про жизнь
  age       Int      @default(0)
  level     Int      @default(0)
  /// Количество: золото, ранг, число сделок. Не текст
  amount    Int      @default(0)
  /// Ключ идемпотентности: actionId хода или свой uuid
  ref       String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([name, ref])
  @@index([createdAt])
  @@index([name, createdAt])
  @@map("insights")
}
